# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Local Go build output (e.g. go build -o bupt-ec)
/bupt-ec
/build/
/dist/

# Frontend build output staged for go:embed (copied from frontend/dist)
/web/dist/

# Test, coverage, and profiling output
*.test
*.out
coverage.out
coverage.html
*.pprof
*.prof

# Dependency directories (remove the comment below to include it)
# vendor/

# Local runtime output
run_log/
.tmp/

# Local secrets and private config
.env

# Project-local workflow files
.claude/
mcps/

# IDE, OS, and editor junk
.idea/
.DS_Store
Thumbs.db
*~
*.bak
*.swp
*.swo
