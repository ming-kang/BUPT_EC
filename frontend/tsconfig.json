{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    /* Types are erased by Vite/esbuild; tsc is the check-only gate (noEmit).
       allowJs keeps mixed batches compiling mid-migration; JS files are not
       type-checked until converted (no checkJs — see parent design D2). */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
